rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validBackup(d) {
      return d is map
        && d.keys().hasAll(['schedule', 'overrides', 'notes'])
        && (d.schedule == null || d.schedule is map)
        && d.overrides is map
        && d.notes is map;
    }
    function validUserDocument() {
      return request.resource.data.keys().hasAll(['data', 'schema', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['data', 'schema', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.updatedAt is timestamp
        && validBackup(request.resource.data.data);
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && validUserDocument();
      allow delete: if false;
    }
    match /users/{userId}/{collectionId}/{documentId}/{nested=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
